FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.lock .
RUN python -m pip install --no-cache-dir --prefix=/install --requirement requirements.lock

FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 10001 gateway
WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
COPY --from=builder /install /usr/local
COPY gateway ./gateway
COPY eval ./eval
COPY docker/seccomp/tool.json ./docker/seccomp/tool.json
COPY .env.example ./.env.example
USER gateway
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from gateway.config import Settings; Settings()"
ENTRYPOINT ["python", "-m", "gateway.server"]
