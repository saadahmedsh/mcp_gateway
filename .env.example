GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_LEVEL=INFO
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_OPA_URL=http://localhost:8181
GATEWAY_OTLP_ENDPOINT=http://localhost:4317
GATEWAY_JAEGER_UI_URL=http://localhost:16686
GATEWAY_DATABASE_PATH=data/gateway.sqlite
GATEWAY_CONTROL_PLANE_ENABLED=false
GATEWAY_CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://gateway:gateway_local@localhost:5432/gateway
GATEWAY_CONTROL_PLANE_POOL_SIZE=5
GATEWAY_CONTROL_PLANE_MAX_OVERFLOW=10
GATEWAY_CONTROL_PLANE_CONNECT_TIMEOUT_SECONDS=3.0
GATEWAY_STATE_STORE_BACKEND=redis
GATEWAY_REDIS_OPERATION_TIMEOUT_SECONDS=2.0
GATEWAY_STATE_TTL_SECONDS=86400
GATEWAY_APPROVAL_TIMEOUT_SECONDS=300
GATEWAY_SANDBOX_RUNTIME=hardened-docker
GATEWAY_SANDBOX_IMAGE=mcp-gateway-tool:local
GATEWAY_SANDBOX_OUTPUT_LIMIT_BYTES=1048576
GATEWAY_SANDBOX_STARTUP_TIMEOUT_SECONDS=30.0
GATEWAY_AUDIT_LOG_PATH=data/audit.jsonl
GATEWAY_REPAIR_ENABLED=false
GATEWAY_REPAIR_LLM_PROVIDER=openai_compatible
GATEWAY_REPAIR_LLM_URL=http://localhost:4000/v1/chat/completions
GATEWAY_REPAIR_LLM_MODEL=repair-model
GATEWAY_REPAIR_LLM_TIMEOUT_SECONDS=15.0
GATEWAY_REPAIR_LLM_ANTHROPIC_VERSION=2023-06-01
GATEWAY_REPAIR_LLM_MAX_TOKENS=1024
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTP_PATH=/mcp
GATEWAY_HTTP_AUTH_MODE=none
GATEWAY_HTTP_MAX_REQUEST_BODY_BYTES=4194304
GATEWAY_HTTP_SESSION_IDLE_TIMEOUT_SECONDS=1800
GATEWAY_HTTP_MAX_SESSIONS=10000
GATEWAY_HTTP_AUTH_TOKEN=
GATEWAY_OIDC_ISSUER_URL=
GATEWAY_OIDC_AUDIENCE=
GATEWAY_OIDC_JWKS_URL=
GATEWAY_OIDC_TIMEOUT_SECONDS=2.0
